# Supabase: DATABASE_URL = transaction pooler (6543, runtime); DIRECT_URL = session pooler (5432, Prisma CLI migrations only)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Never use the "Direct connection" string (db.[REF].supabase.co): it is IPv6-only on the free tier and Vercel is IPv4-only
# Use a letters-and-numbers-only password to avoid percent-encoding it in three places
# Auth.js / NextAuth v5 - generate with: npx auth secret
AUTH_SECRET=""
# First-admin bootstrap; clear ADMIN_PASSWORD once the admin user exists
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Vercel Blob (thumbnail uploads) - Vercel Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=""
# OpenCode Go API key (AI blog generation)
OPENCODE_GO_API_KEY=""
# Settings encryption for stored integration tokens - generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""
# Web search for article review (Tavily). Without a key, reviews still run and claims are marked unverifiable.
WEB_SEARCH_PROVIDER="tavily"
WEB_SEARCH_API_KEY=""
# Vercel Cron protection - openssl rand -hex 32; must match the value in Vercel
CRON_SECRET=""
# Google service account with Search Console read access; add its email as a user on the property, then paste private_key exactly as in the JSON, keeping \n escapes
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Search Console property, e.g. sc-domain:davidmallick.dev
GSC_PROPERTY=""
# Google OAuth client for the Search Console dashboard. Register both redirect URIs:
#   https://davidmallick.dev/api/google/oauth/callback
#   http://localhost:3000/api/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Google Ads Keyword Planner. The developer token needs Basic access level or higher
# (a test account token returns no real metrics); the customer ID, optional MCC login
# customer ID, geo, and language are set in /admin/settings as keywords.planner.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL="https://davidmallick.dev"

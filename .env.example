# ------------------------------------------------------------------
# Database (Prisma Postgres)
# Get it from: https://console.prisma.io -> your project -> Connection string
# ------------------------------------------------------------------
DATABASE_URL="postgres://..."

# ------------------------------------------------------------------
# Auth.js / NextAuth v5
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# ------------------------------------------------------------------
AUTH_SECRET=""

# ------------------------------------------------------------------
# Vercel Blob (thumbnail uploads)
# Vercel Dashboard -> Storage -> Blob -> .env.local tab
# ------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------
# OpenCode Go API key (AI blog generation)
# Get it from: https://opencode.ai/auth -> subscribe to Go -> copy API key
# ------------------------------------------------------------------
OPENCODE_GO_API_KEY=""

# ------------------------------------------------------------------
# Vercel Cron protection
# Any random string. Vercel automatically sends it as a Bearer token
# to your cron route once this env var exists.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------
CRON_SECRET=""

# ------------------------------------------------------------------
# Google service account (Indexing API + Search Console)
# GCP Console -> IAM & Admin -> Service Accounts -> create key (JSON)
# The service account email must be added as an OWNER in Search Console.
# Paste the private_key value exactly as it appears in the JSON file
# (keep the \n escapes; the app converts them to real newlines).
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Search Console property, e.g. "sc-domain:yourdomain.com"
# or a URL-prefix property such as "https://yourdomain.com/"
GSC_PROPERTY=""

# Public canonical site URL (no trailing slash).
# Used for canonical URLs, sitemap, and Google indexing.
NEXT_PUBLIC_SITE_URL="https://david-dew-mallick.vercel.app"

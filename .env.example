# ------------------------------------------------------------------
# Database (Supabase PostgreSQL via Supavisor pooler)
# Supabase Dashboard -> project -> Connect (green button) -> Connection string
#
# DATABASE_URL: Transaction pooler (port 6543), runtime queries.
#   Serverless functions scale horizontally; the pooler absorbs the spikes.
# DIRECT_URL: Session pooler (port 5432), Prisma CLI / migrations only.
#   Do NOT use the "Direct connection" string: it is IPv6-only on the free
#   tier and Vercel is IPv4-only, so migrations would fail to resolve.
#
# Use a letters-and-numbers-only password to avoid percent-encoding it in
# three separate places.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------
# Auth.js / NextAuth v5
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# ------------------------------------------------------------------
AUTH_SECRET=""

# ------------------------------------------------------------------
# First-admin bootstrap gate
#
# While the User table is empty, the admin account is created on the first
# sign-in ONLY when the submitted credentials match both values below.
# This stops a stranger from claiming the admin panel on a fresh deployment.
#
# Set both before your first sign-in. Once your admin user exists, clear
# ADMIN_PASSWORD to disable the bootstrap path entirely.
# ------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ------------------------------------------------------------------
# Vercel Blob (thumbnail uploads)
# Vercel Dashboard -> Storage -> Blob -> .env.local tab
# ------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------
# OpenCode Go API key (AI blog generation)
# Get it from: https://opencode.ai/auth -> subscribe to Go -> copy API key
# ------------------------------------------------------------------
OPENCODE_GO_API_KEY=""

# ------------------------------------------------------------------
# Vercel Cron protection
# Any random string. Vercel automatically sends it as a Bearer token
# to your cron route once this env var exists.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------
CRON_SECRET=""

# ------------------------------------------------------------------
# Google service account (Indexing API + Search Console)
# GCP Console -> IAM & Admin -> Service Accounts -> create key (JSON)
# The service account email must be added as an OWNER in Search Console.
# Paste the private_key value exactly as it appears in the JSON file
# (keep the \n escapes; the app converts them to real newlines).
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Search Console property, e.g. "sc-domain:yourdomain.com"
# or a URL-prefix property such as "https://yourdomain.com/"
GSC_PROPERTY=""

# Public canonical site URL (no trailing slash).
# Used for canonical URLs, sitemap, robots.txt, JSON-LD, and Google indexing.
NEXT_PUBLIC_SITE_URL="https://davidmallick.dev"
